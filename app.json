{
  "expo": {
    "name": "Lourenço Barbearia",
    "slug": "lourenco-barbearia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2C68"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lourenco.barbearia",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para registrar seus cortes no álbum de memórias.",
        "NSPhotoLibraryUsageDescription": "Acesso à galeria para selecionar fotos dos seus cortes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-icon.png",
        "backgroundColor": "#0D2C68"
      },
      "package": "com.lourenco.barbearia",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/logo-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Acesso à galeria para selecionar fotos dos seus cortes.",
          "cameraPermission": "A câmera é usada para registrar seus cortes no álbum de memórias."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
